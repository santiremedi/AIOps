        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"PharmaGo.ApiGateway\"}[1m]))",
          "legendFormat": "{{http_route}}",
