          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "title": "Tráfico por endpoint (gateway)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
